local UI=require(game:GetService("ReplicatedStorage"):WaitForChild("MansionUI"))
local player=game:GetService("Players").LocalPlayer
local screen=UI.Screen(player:WaitForChild("PlayerGui"))
local window=UI.Window(screen,"Mansion UI - Component Gallery",{Size=UDim2.fromOffset(500,660)})
local section=UI.Section(window.Body,"Settings")
UI.Button(section,"Show confirmation",function()
 UI.ConfirmBox(screen,{Title="Save changes?",Message="This is a standalone Mansion UI dialog.",OnResult=function(value)
  UI.Notify(screen,"Result",value and "Confirmed" or "Cancelled",3)
 end})
end,{Size=UDim2.new(1,0,0,40)})
UI.Toggle(section,"Enabled",true,function(value) print("Enabled",value) end)
UI.Dropdown(section,{"English","French","Japanese"},"English",function(value) print("Language",value) end)
UI.Slider(section,"Volume",0,100,65,1,function(value) print("Volume",value) end)
UI.Search(section,function(value) print("Search",value) end)
UI.Progress(section,0.7)
UI.Button(section,"Primary",nil,{Size=UDim2.new(1,0,0,40)})
UI.Button(section,"Success",nil,{Size=UDim2.new(1,0,0,40),ImageColor3=UI.GetColor("MainPositive")})
UI.Button(section,"Warning",nil,{Size=UDim2.new(1,0,0,40),ImageColor3=UI.GetColor("MainWarning")})
local disabled=UI.Button(section,"Disabled",nil,{Size=UDim2.new(1,0,0,40)})
UI.SetButtonState(disabled,false)
local function fit() UI.Fit(window.Frame,workspace.CurrentCamera.ViewportSize) end
fit();workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(fit)
